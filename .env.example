# Trimora Environment Variables Example
PORT=3000
NODE_ENV=development

# Optional AI Vision & LLM APIs (Built-in heuristic analysis operates automatically if keys are omitted)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# Optional Database & Storage (Default is zero-config local relational engine)
# MONGODB_URI=mongodb://localhost:27017/trimora
# BACKEND_PORT=5000
# Supabase Database & Auth Service (Required for live Supabase sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Brevo (formerly Sendinblue) Transactional Email API for User Login via Email OTP
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=appointments@johnsalonkkd.com
BREVO_SENDER_NAME="Trimorva | John Salon KKD"
