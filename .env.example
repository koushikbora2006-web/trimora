# Trimora Environment Variables Example
PORT=3000
NODE_ENV=development

# Optional AI Vision & LLM APIs (Built-in heuristic analysis operates automatically if keys are omitted)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# Optional Database & Storage (Default is zero-config local relational engine)
# MONGODB_URI=mongodb://localhost:27017/trimora
# BACKEND_PORT=5000
# DATABASE_URL=postgresql://postgres:password@localhost:5432/trimora
# NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...
